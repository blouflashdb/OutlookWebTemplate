{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev Server",
      "type": "shell",
      "command": "pnpm dev",
      "isBackground": true,
      "presentation": {
        "panel": "dedicated"
      },
      // Lets the debugger start once Vite reports that it is ready.
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "Stop Dev Server",
      "type": "shell",
      "command": "echo ${input:terminateDevServer}",
      "problemMatcher": []
    },
    {
      "label": "Debug: Outlook Desktop",
      "type": "shell",
      "command": "pnpm start",
      "presentation": {
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Stop Debug",
      "type": "shell",
      "command": "pnpm stop",
      "presentation": {
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "terminateDevServer",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "Dev Server"
    }
  ]
}
