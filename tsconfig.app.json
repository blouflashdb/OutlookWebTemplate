// TSConfig for the add-in code that runs inside Outlook's webview.
{
  "extends": [
    "@tsconfig/strictest/tsconfig.json",
    // Only erasable TypeScript syntax: no enums, namespaces or parameter properties.
    "@tsconfig/node-ts/tsconfig.json"
  ],
  "compilerOptions": {
    // `vue-tsc --build` writes a .tsbuildinfo file; keep it out of the project root.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "target": "ES2022",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,

    // Vite does the bundling; TypeScript only type-checks.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["office-js", "vite/client"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // From @tsconfig/node-ts, but only relevant when tsc emits, and it rejects `.vue` imports.
    "rewriteRelativeImportExtensions": false
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "auto-imports.d.ts", "components.d.ts"],
  "exclude": ["src/**/*.spec.ts", "src/test-utils"]
}
