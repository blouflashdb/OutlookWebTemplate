{
  "name": "outlook-web-template",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "description": "Template for Outlook Web Add-ins built with Vue 3, Vite and TypeScript",
  "license": "MIT",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml",
    "start": "office-addin-debugging start manifest.xml desktop --app outlook --dev-server \"pnpm dev\" --dev-server-port 3000",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "certs:install": "office-addin-dev-certs install"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.147",
    "@nuxt/ui": "^4.12.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node24": "^24.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.19.2",
    "@types/office-js": "^1.0.614",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-erasable-syntax-only": "^0.7.2",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "lefthook": "2.2.1",
    "office-addin-debugging": "^7.0.1",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-manifest": "^3.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
